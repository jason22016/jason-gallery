{
  "name": "jason-gallery",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "tsc --noEmit",
    "photos": "node --import tsx scripts/photos/sync.ts",
    "test:smoke": "node --import tsx scripts/photos/network-smoke.ts && node --import tsx scripts/photos/smoke.ts",
    "test:viewer": "node --import tsx tests/viewer/prepare.ts && vite build --config tests/viewer/vite.config.ts && node --import tsx tests/viewer/check-bundle.ts && node --import tsx --test tests/viewer/color.test.ts",
    "viewer:dev": "node --import tsx tests/viewer/prepare.ts && vite --config tests/viewer/vite.config.ts",
    "test:projects": "node --import tsx --test tests/projects/*.test.ts",
    "test:website": "node --import tsx --test tests/website/*.test.ts",
    "website:fixture": "node --import tsx tests/website/fixture.ts",
    "website:preview": "node --import tsx tests/website/server.ts",
    "test": "pnpm test:checks && pnpm test:metadata-real && pnpm build",
    "photos:verify": "node --import tsx scripts/photos/verify-full.ts",
    "ui:preview": "node --import tsx tests/website/preview.ts --serve",
    "automation": "node --import tsx scripts/ci/cli.ts",
    "test:automation": "node --import tsx --test tests/ci/*.test.ts",
    "test:checks": "pnpm check && pnpm test:projects && pnpm test:smoke && pnpm test:viewer && pnpm test:website && pnpm test:automation",
    "test:metadata-real": "node --import tsx --test tests/website/real-metadata.audit.ts"
  },
  "dependencies": {
    "@afilmory/builder": "workspace:*",
    "@afilmory/typing": "workspace:*",
    "@afilmory/utils": "workspace:*",
    "@afilmory/viewer-motion": "workspace:*",
    "@afilmory/webgl-viewer": "workspace:*",
    "@astrojs/react": "6.0.5",
    "astro": "7.3.2",
    "lucide-react": "1.18.0",
    "maplibre-gl": "5.24.0",
    "masonic": "4.1.0",
    "motion": "12.38.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "thumbhash": "0.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@webgpu/types": "0.1.72",
    "playwright": "1.62.1",
    "sharp": "0.35.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.130.0"
  }
}
