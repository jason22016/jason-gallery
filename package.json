{
  "name": "jason-gallery",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "tsc --noEmit",
    "photos": "node --import tsx scripts/photos/sync.ts",
    "test:smoke": "node --import tsx scripts/photos/network-smoke.ts && node --import tsx scripts/photos/smoke.ts",
    "test:viewer": "node --import tsx tests/viewer/prepare.ts && vite build --config tests/viewer/vite.config.ts && node --import tsx tests/viewer/check-bundle.ts && node --import tsx --test --test-concurrency=1 tests/viewer/*.test.ts",
    "viewer:dev": "node --import tsx tests/viewer/prepare.ts && vite --config tests/viewer/vite.config.ts",
    "test:projects": "node --import tsx --test tests/projects/*.test.ts",
    "test:website": "node --import tsx --test --test-concurrency=1 tests/website/*.test.ts",
    "website:fixture": "node --import tsx tests/website/fixture.ts",
    "website:preview": "node --import tsx tests/website/server.ts",
    "test": "pnpm test:checks && pnpm test:metadata-real && pnpm build",
    "photos:verify": "node --import tsx scripts/photos/verify-full.ts",
    "ui:preview": "node --import tsx tests/website/preview.ts --serve",
    "automation": "node --import tsx scripts/ci/cli.ts",
    "test:automation": "node --import tsx --test tests/ci/*.test.ts",
    "test:checks": "pnpm check:upstream && pnpm check && pnpm test:projects && pnpm test:smoke && pnpm test:viewer && pnpm test:website && pnpm test:automation && pnpm test:admin",
    "test:metadata-real": "node --import tsx --test tests/website/real-metadata.audit.ts",
    "admin:preview": "node --import tsx tests/admin/prepare.ts --local-photos && vite --config tests/admin/vite.config.ts",
    "admin:fixture": "node --import tsx tests/admin/prepare.ts && vite --config tests/admin/vite.config.ts",
    "test:admin": "node --import tsx --test --test-concurrency=1 tests/admin/*.test.ts",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:prepare": "node --import tsx scripts/admin/prepare.ts",
    "admin:verify-package": "node --import tsx scripts/admin/prepare.ts --verify",
    "admin:dev": "pnpm admin:build && wrangler dev --config admin/wrangler.jsonc",
    "admin:profile": "pnpm admin:build && wrangler deploy --dry-run --config admin/wrangler.jsonc --outdir .cache/admin-profile-worker && node --import tsx tests/admin/profile.ts",
    "admin:types": "wrangler types admin/worker-configuration.d.ts --config admin/wrangler.jsonc --include-runtime false --strict-vars false",
    "check:upstream": "node --import tsx scripts/upstream/check-viewer.ts"
  },
  "dependencies": {
    "@afilmory/builder": "workspace:*",
    "@afilmory/typing": "workspace:*",
    "@afilmory/utils": "workspace:*",
    "@afilmory/viewer-motion": "workspace:*",
    "@afilmory/webgl-viewer": "workspace:*",
    "@astrojs/react": "6.0.5",
    "@radix-ui/react-hover-card": "1.1.23",
    "@tanstack/react-virtual": "3.14.3",
    "@zip.js/zip.js": "2.14.0",
    "astro": "7.3.2",
    "file-type": "22.0.1",
    "heic-to": "1.5.2",
    "jose": "6.2.12",
    "lucide-react": "1.18.0",
    "maplibre-gl": "5.24.0",
    "masonic": "4.1.0",
    "motion": "12.38.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swiper": "12.2.0",
    "thumbhash": "0.1.1",
    "tiff": "7.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@webgpu/types": "0.1.72",
    "playwright": "1.62.1",
    "sharp": "0.35.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.130.0"
  }
}
