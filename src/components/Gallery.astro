---
import type { ResolvedProject } from '../projects';
import Thumbnail from './ui/Thumbnail.astro';
import ProjectGallery from './gallery/ProjectGallery';
import { galleryPhotos } from './gallery/photos';
import { LinearBlur } from './gallery/ui/LinearBlur';
import { ViewerAttribution } from './viewer/ViewerAttribution';
import './gallery/GalleryTokens.css';
import './gallery/GalleryIcons.css';
import '../styles/gallery.css';
interface Props { project: ResolvedProject; }
const { project } = Astro.props;
const photos = galleryPhotos(project);
const { title, slug, summary, description, location, period, tags } = project;
---
<section data-project-gallery aria-label={`${project.title} photographs`}>
  <div data-static-gallery>
    <header class="gallery-header"><LinearBlur className="gallery-header-blur" tint="var(--color-background)" strength={128} side="top" aria-hidden="true" /><div class="gallery-header-content"><a class="gallery-action" href="/" aria-label="返回首页">←</a><h1 title={title}>{title}</h1><span class="gallery-count">{photos.length}</span>
      <details class="static-info"><summary>项目信息</summary><div class="panel-body">
        {summary && <p>{summary}</p>}
        <dl class="project-details"><dt>地点</dt><dd>{location}</dd><dt>日期</dt><dd>{period?.start}{period?.end && period.end !== period.start && ` — ${period.end}`}</dd></dl>
        {description && <p class="project-description">{description}</p>}
        <ul class="tags">{tags?.map(tag => <li>{tag}</li>)}</ul>
        <ViewerAttribution />
      </div></details>
    </div></header>
    <ol class="photo-grid static-grid">{photos.map((photo, index) => <li data-photo-id={photo.id}>
      <a class="photo-link" href={photo.src} data-gallery-index={index} aria-label={`查看照片：${photo.alt}`}>
        <Thumbnail src={photo.thumbnail} alt={photo.alt} width={photo.width} height={photo.height} eager={index < 5} />
      </a>
    </li>)}</ol>
  </div>
  <ProjectGallery photos={photos} project={{ title, slug, summary, description, location, period, tags }} client:only="react" />
</section>
