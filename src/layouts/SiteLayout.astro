---
import '../styles/global.css';
import { canonicalURL, DEFAULT_SHARE_IMAGE, NOINDEX, SITE_DESCRIPTION, SITE_NAME, textSummary } from '../website/seo';
interface Props { title?: string; description?: string; gallery?: boolean; noindex?: boolean; image?: { path: string; alt: string }; }
const { title, description = SITE_DESCRIPTION, gallery = false, noindex = false, image = { path: DEFAULT_SHARE_IMAGE, alt: `${SITE_NAME} — Photography` } } = Astro.props;
const pageTitle = title ? `${title.trim()} — ${SITE_NAME}` : `${SITE_NAME} — Photography`;
const pageDescription = textSummary(description) || SITE_DESCRIPTION;
const canonical = noindex ? undefined : canonicalURL(Astro.url.pathname, Astro.site);
const shareImage = Astro.site && !noindex ? new URL(image.path, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex || !Astro.site ? NOINDEX : 'index, follow, max-image-preview:large'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <>
      <meta property="og:image" content={shareImage} />
      <meta property="og:image:alt" content={image.alt} />
      <meta property="og:image:type" content="image/jpeg" />
    </>}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {shareImage && <><meta name="twitter:image" content={shareImage} /><meta name="twitter:image:alt" content={image.alt} /></>}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
  </head>
  <body class={gallery ? 'gallery-page' : 'portfolio-page'}>
    <a class="skip-link" href="#main">跳至内容</a>
    {!gallery && <header class="site-header shell"><a class="wordmark" href="/" aria-label="Jason Gallery 首页">Jason Gallery<span>.</span></a></header>}
    <main id="main" class={gallery ? 'gallery-main' : 'shell'} tabindex="-1"><slot /></main>
    {!gallery && <footer class="site-footer shell"><span>© Jason Gallery</span><a href="/">Projects</a></footer>}
  </body>
</html>
