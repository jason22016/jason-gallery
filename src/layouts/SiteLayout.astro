---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = 'Photography projects by Jason.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f2ed" />
    <title>{title ? `${title} — Jason Gallery` : 'Jason Gallery — Photography'}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="Jason Gallery home">Jason<span>Gallery</span></a>
      <nav aria-label="Main navigation"><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Projects</a></nav>
    </header>
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <footer class="site-footer shell"><a href="/">Jason Gallery</a><span>Photography</span></footer>
  </body>
</html>
