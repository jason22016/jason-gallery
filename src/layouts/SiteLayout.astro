---
import '../styles/global.css';
import { ThemeControl } from '../components/ThemeControl';
import themeBootstrap from '../theme/bootstrap.js?raw';
import { SiteNavigation } from '../components/SiteNavigation';
import { canonicalURL, DEFAULT_SHARE_IMAGE, NOINDEX, SITE_DESCRIPTION, SITE_NAME, textSummary } from '../website/seo';
interface Props { title?: string; description?: string; gallery?: boolean; noindex?: boolean; shareable?: boolean; themeControl?: boolean; image?: { path: string; alt: string }; }
const { title, description = SITE_DESCRIPTION, gallery = false, noindex = false, shareable = !noindex, themeControl = true, image = { path: DEFAULT_SHARE_IMAGE, alt: `${SITE_NAME} — Photography` } } = Astro.props;
const pageTitle = title ? `${title.trim()} — ${SITE_NAME}` : `${SITE_NAME} — Photography`;
const pageDescription = textSummary(description) || SITE_DESCRIPTION;
const canonical = shareable ? canonicalURL(Astro.url.pathname, Astro.site) : undefined;
const shareImage = Astro.site && shareable ? new URL(image.path, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={themeBootstrap} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex || !Astro.site ? NOINDEX : 'index, follow, max-image-preview:large'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <>
      <meta property="og:image" content={shareImage} />
      <meta property="og:image:alt" content={image.alt} />
      <meta property="og:image:type" content="image/jpeg" />
    </>}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {shareImage && <><meta name="twitter:image" content={shareImage} /><meta name="twitter:image:alt" content={image.alt} /></>}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
  </head>
  <body class={gallery ? 'gallery-page' : 'portfolio-page'}>
    <a class="skip-link" href="#main">跳至内容</a>
    {themeControl && <div class="site-theme-control"><ThemeControl client:load /></div>}
    {!gallery && <header class="site-header shell"><a class="wordmark" href="/" aria-label="Jason Gallery 首页">Jason Gallery<span>.</span></a><SiteNavigation current={Astro.url.pathname === '/' ? 'projects' : undefined} /></header>}
    <main id="main" class={gallery ? 'gallery-main' : 'shell'} tabindex="-1"><slot /></main>
    {!gallery && <footer class="site-footer shell"><span>© Jason Gallery</span><a href="/">Projects</a></footer>}
  </body>
</html>
