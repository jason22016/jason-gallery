---
import '../styles/global.css';
interface Props { title?: string; description?: string; gallery?: boolean; }
const { title, description = 'Photography projects by Jason.', gallery = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={gallery ? '#161616' : '#ffffff'} />
    <title>{title ? `${title} — Jason Gallery` : 'Jason Gallery — Photography'}</title>
  </head>
  <body class={gallery ? 'gallery-page' : 'portfolio-page'}>
    <a class="skip-link" href="#main">跳至内容</a>
    {!gallery && <header class="site-header shell"><a class="wordmark" href="/" aria-label="Jason Gallery 首页">Jason Gallery<span>.</span></a></header>}
    <main id="main" class={gallery ? 'gallery-main' : 'shell'} tabindex="-1"><slot /></main>
    {!gallery && <footer class="site-footer shell"><span>© Jason Gallery</span><a href="/">Projects</a></footer>}
  </body>
</html>
