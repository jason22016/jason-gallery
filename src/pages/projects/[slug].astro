---
import type { GetStaticPaths } from 'astro';
import { loadProjects, type ResolvedProject } from '../../projects';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Gallery from '../../components/Gallery.astro';
export const getStaticPaths = (() => loadProjects().listProjects().map(project => ({
  params: { slug: project.slug }, props: { project },
}))) satisfies GetStaticPaths;
interface Props { project: ResolvedProject; }
const { project } = Astro.props;
---
<SiteLayout title={project.title} description={project.summary ?? project.title} gallery>
  <Gallery project={project} />
</SiteLayout>
